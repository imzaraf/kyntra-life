# Public Firebase web config. These values are bundled into browser code BY DESIGN —
# they are identifiers, not secrets. Security comes from Auth + Firestore rules.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
# Public Web Push (VAPID) key from Firebase console → Cloud Messaging
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_public_web_push_vapid_key

# Set to "true" to connect to local Firebase emulators in development
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Server-only secrets are NEVER placed here. Cloud Functions use Application
# Default Credentials in deployment; use `firebase functions:secrets:set` for any secret.

# Public URL of the deployed site (used for absolute Open Graph/Twitter image URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
